@model VaultIndexViewModel
@{
    ViewData["Title"] = "My vault";
}
<section class="page-heading compact-heading">
    <p class="eyebrow">PRIVATE WORKSPACE</p>
    <div class="heading-row"><div><h1>My vault</h1><p class="muted">Only notes owned by your account are returned.</p></div><a class="button primary" asp-action="Create">New note</a></div>
</section>
<form method="get" asp-action="Index" class="search-form">
    <label for="q">Search my notes</label>
    <input id="q" name="q" value="@Model.SearchTerm" maxlength="100" placeholder="Search title or content" />
    <button class="button secondary" type="submit">Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) { <a asp-action="Index" class="clear-link">Clear</a> }
</form>
@if (ViewData["SearchError"] is string searchError)
{
    <div class="notice error" role="alert">@searchError</div>
}
@if (Model.Notes.Count == 0)
{
    <div class="empty-state"><h2>No notes found</h2><p>Create a note or change the search term.</p><a asp-action="Create" class="button primary">Create a note</a></div>
}
else
{
    <div class="note-grid">
    @foreach (var note in Model.Notes)
    {
        <article class="note-card">
            <div class="note-meta"><span>Created @note.CreatedUtc.ToLocalTime().ToString("g")</span><span>Note #@note.Id</span></div>
            <h2>@note.Title</h2>
            @* Razor encodes note content here. Do not replace with Html.Raw. *@
            <p class="note-content">@note.Content</p>
            @if (note.UpdatedUtc is not null) { <p class="muted small">Updated @note.UpdatedUtc.Value.ToLocalTime().ToString("g")</p> }
            <div class="note-actions">
                <a asp-action="Edit" asp-route-id="@note.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@note.Id" method="post">
                    <button class="link-button danger-text" type="submit">Delete</button>
                </form>
            </div>
        </article>
    }
    </div>
}
