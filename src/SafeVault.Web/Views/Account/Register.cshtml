@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}
<section class="auth-panel">
    <p class="eyebrow">NEW ACCOUNT</p>
    <h1>Create your SafeVault account</h1>
    <p class="muted">Use a unique password you do not use on other sites.</p>
    <form asp-controller="Account" asp-action="Register" method="post" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="form-field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" required />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password" required />
            <span asp-validation-for="Password" class="field-error"></span>
            <small>At least 12 characters, including uppercase, lowercase, a number, and a symbol.</small>
        </div>
        <div class="form-field">
            <label asp-for="ConfirmPassword">Confirm password</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" required />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <button class="button primary full-width" type="submit">Create account</button>
    </form>
    <p class="form-footer">Already registered? <a asp-action="Login">Sign in</a>.</p>
</section>
